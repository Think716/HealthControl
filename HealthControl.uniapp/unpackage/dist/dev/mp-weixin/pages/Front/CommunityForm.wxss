/* 水平间距 */
.publish-content.data-v-c81a5dde {
  padding: 30rpx;
  min-height: calc(100vh - 60px);
  /* 减去导航栏高度 */
  background-color: #fff;
  /* 确保有白色背景 */
}
.picker-row.data-v-c81a5dde {
  padding: 24rpx 30rpx;
  background-color: #ecfdf5;
  border-radius: 12rpx;
  color: var(--primary-dark, #065f46);
  font-size: 28rpx;
}
.content-input.data-v-c81a5dde {
  width: 100%;
  height: 280rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--bg-color-light, #f9fafb);
  color: #333;
  font-size: 28rpx;
}
.tag-list.data-v-c81a5dde {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.tag.data-v-c81a5dde {
  padding: 16rpx 32rpx;
  background-color: #f8f8f8;
  border-radius: 40rpx;
  color: #666;
  font-size: 28rpx;
  transition: all 0.3s ease;
}
.tag.active.data-v-c81a5dde {
  background-color: var(--primary-color, #10b981);
  color: #fff;
}
.images.data-v-c81a5dde {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}
.image.data-v-c81a5dde,
.add-image.data-v-c81a5dde {
  width: 100%;
  height: 190rpx;
  border-radius: 12rpx;
}
.add-image.data-v-c81a5dde {
  background-color: #f3f4f6;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
}
.submit-btn.data-v-c81a5dde {
  margin-top: 28rpx;
  width: 100%;
  border-radius: 12rpx;
  font-size: 30rpx;
}